[Unit]
Description=Agent Factory audit chain verification
OnFailure=factory-alert@%n.service

[Service]
Type=oneshot
User=factory-exec
WorkingDirectory=/opt/agent-factory-2
EnvironmentFile=/opt/agent-factory-2/.env
Environment=PYTHONPATH=/opt/agent-factory-2/src HOME=/var/lib/factory
ExecStart=/opt/agent-factory-2/.venv/bin/python -m factory.cli verify-audit
